import orbalion.*

describe "Test Orbalion"{
const x = new Entrenador(cantCiclosSolaresExp=12,estaEnSintonia=true,nivelPrecisionEstrategica= 90,rol=estrategaCuantico)
const y = new Entrenador(cantCiclosSolaresExp=15,estaEnSintonia= false, nivelPrecisionEstrategica=50,rol= guiaMental)
const j = new Entrenador(cantCiclosSolaresExp=11,estaEnSintonia=false,nivelPrecisionEstrategica=99,rol=arquitectoDeEnergia)
const equipoL1 = new Luminico(nombre="L1",nivelDeEnergiaBase=200,entrenador=x,nivelDeRadiacionCapturada=3000)
const equipoL = new Luminico(nombre="L",nivelDeEnergiaBase=400,entrenador=x,nivelDeRadiacionCapturada=5010)
const equipoS = new Sintetico(nombre="S",nivelDeEnergiaBase=300, entrenador=y,nivelDeProcesamientoCentral=3,cantModulosActivos=6,estanCertificados=true)
const equipoS1 = new Sintetico(nombre="S",nivelDeEnergiaBase=300, entrenador=y,nivelDeProcesamientoCentral=3,cantModulosActivos=4,estanCertificados=true)
const equipoE = new Eterico(nombre="E", nivelDeEnergiaBase=500,entrenador=j,nivelFluctuacion=10,cantPortalesAbiertos=2)
const equipoE1 = new Eterico(nombre="E1", nivelDeEnergiaBase=700,entrenador=j,nivelFluctuacion=80,cantPortalesAbiertos=3)
const nucleoGravitacional = new TecnologiasEspeciales(nombre="NG",valorEnergetico=10,estaActiva=true)
const interfazDeProyeccionMental= new TecnologiasEspeciales(nombre="IPM",valorEnergetico=30,estaActiva=false)
const camaraDeFusionEnergetica = new TecnologiasEspeciales(nombre="CFE",valorEnergetico=25,estaActiva=true)

test "Dado que un entrenador se le asigna un rol distinto a los autorizados por la FOZ, lanza un error con el mensaje -Rol no homologadopor la FOZ-"{
    assert.throwsExceptionWithMessage("Rol no homologado por la FOZ",{x.asignarRol(guiaCuantico)})
}
test "Dado un equipo luminco con radioacion > 5000 y sin tecnologias activas,su energia total es su energia base"{
    equipoL.agregarTecnologia(interfazDeProyeccionMental)
    assert.equals(400,equipoL.energiaTotal())
}
test "Dado un equipo luminco con radioacion < 5000 y sin tecnologias activas,su energia total es su energia base con un 10% de bono"{
    equipoL1.agregarTecnologia(interfazDeProyeccionMental)
    assert.equals(220,equipoL1.energiaTotal())
}
test "Dado un equipo sintetico con 6 modulos activos , recibe una penalizacion del 20%"{
    equipoS.agregarTecnologia(camaraDeFusionEnergetica)
    assert.equals(260,equipoS.energiaTotal())
}
test "Dado u equipo sintetico con 4 modulos activos, y 2 tecnologias activas, su energia total es la suma de su energia base mas el valor energetico de las tecnologias activas"{
    equipoS1.agregarTecnologia(camaraDeFusionEnergetica)
    equipoS1.agregarTecnologia(nucleoGravitacional)
    assert.equals(335,equipoS1.energiaTotal())
}
test "Dado un entrenador con rol de estratega cuantico con 12 ciclos solares de experiencia y nivel de precision estrategica de 90, es de elite galactica"{
    assert.that(x.esEliteGalactico())
}
test "Dado un entrenado con rol arquitecto de energia con 11 ciclos solares de experiencia y no esta en sintonia, no es de elite galactica"{
    assert.notThat(j.esEliteGalactico())
}
test "Dado un entrenador con rol de guia mental con 15 ciclos solares de experiencia, es de elite galactica"{
    assert.that(y.esEliteGalactico())
}
test "Dado un equipo Luminico con 3 cristales, entrenador de elite y una tecnologia activa, es equipo es de prestigio Universal"{
    equipoL.agregarCristalSolar("SOL")
    equipoL.agregarCristalSolar("FEBO")
    equipoL.agregarCristalSolar("RA")
    equipoL.agregarTecnologia(nucleoGravitacional)
    assert.that(equipoL.esDePrestigioUniversal())
}
test "Dado un equipo sintetico con 4 modulos y todas las tecnologias activas, es de prestigio universal"{
    equipoS1.agregarTecnologia(camaraDeFusionEnergetica)
    equipoS1.agregarTecnologia(nucleoGravitacional)
    assert.that(equipoS1.esDePrestigioUniversal())
}
test "Dado un equipo luminico con 2 cristales, entrenador de elite y una tecnologia activa, no es de prestigio universal"{
    equipoL1.agregarCristalSolar("SOL")
    equipoL1.agregarCristalSolar("FEBO")
    equipoL1.agregarTecnologia(nucleoGravitacional)
    assert.notThat(equipoL1.esDePrestigioUniversal())
}
test "Dado un equipo sintetico con 6 modulos activos, esta certificado y tiene una tecnologia no activa, no es de prestigio universal"{
    equipoS.agregarTecnologia(interfazDeProyeccionMental)
    equipoS.agregarTecnologia(nucleoGravitacional)
    assert.notThat(equipoS.esDePrestigioUniversal())
}
test "Dado un equipo eterico con 3 portales abiertos, nivel de fluctuacion de 80 y 2 tecnologias activas, es de prestigio universal"{
    equipoE1.agregarTecnologia(nucleoGravitacional)
    equipoE1.agregarTecnologia(camaraDeFusionEnergetica)
    assert.that(equipoE1.esDePrestigioUniversal())
}
test "Ddo un equipo eterico de prestigio universal, su energia total es la suma de su energia base mas el valor energetico de las tecnologias activas con un bono del 15%"{
    equipoE1.agregarTecnologia(nucleoGravitacional)
    equipoE1.agregarTecnologia(camaraDeFusionEnergetica)
    assert.equals(845.25,equipoE1.energiaTotal())
}
test "Dado un equipo eterico que no es de prestigio universal, su energia total es la suma de su energia base mas el valor energetico de las tecnologias activas pero sin el 15% de bono"{
    equipoE.agregarTecnologia(nucleoGravitacional)
    equipoE.agregarTecnologia(camaraDeFusionEnergetica)
    assert.equals(535,equipoE.energiaTotal())
}
}
